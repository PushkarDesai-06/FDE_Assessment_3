# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: Groq (OpenAI-compatible API). Get keys at https://console.groq.com
# Comma-separated keys are used round-robin, one per request; a rate-limited key is rested
# and the request moves to the next key. GROQ_API_KEY (single key) is also added to the pool.
GROQ_API_KEYS=
# GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Optional overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint (then set LLM_API_KEY)
# LLM_API_KEY=
# REASONING_EFFORT=low
# LLM_TEMPERATURE=0
# LLM_TIMEOUT_SECONDS=60
